<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@+id/inv_touch_outside_root"
    android:background="@android:color/transparent"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_gravity="center|top"
        android:id="@+id/inv_second_bubble"
        android:background="@drawable/inv_record_bubble_bg"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="38.0dip"
        android:layout_height="38.0dip"
        android:translationZ="0.0dip"
        android:elevation="0.0dip">
        <TextView
            android:textSize="16.0sp"
            android:textColor="#ffff3b30"
            android:gravity="center"
            android:id="@+id/inv_second_bubble_icon"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:text="●" />
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center|top"
        android:id="@+id/inv_island_panel"
        android:background="@drawable/inv_island_state_bg"
        android:focusable="true"
        android:clickable="true"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="100.0dip"
        android:layout_height="38.0dip">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/inv_collapsed_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ImageView
                android:layout_gravity="start|center"
                android:id="@+id/inv_album_collapsed"
                android:background="@drawable/inv_island_album_round_12"
                android:layout_width="26.0dip"
                android:layout_height="26.0dip"
                android:scaleType="centerCrop"
                android:layout_marginStart="16.0dip" />
            <inv.systemui.dynamic.InvEqualizerView
                android:layout_gravity="end|center"
                android:id="@+id/inv_equalizer_icon"
                android:layout_width="25.0dip"
                android:layout_height="25.0dip"
                android:layout_marginEnd="16.0dip" />
            <TextView
                android:textSize="17.0sp"
                android:textColor="#ffff3b30"
                android:layout_gravity="start|center"
                android:id="@+id/inv_record_dot"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:layout_marginStart="12.0dip" />
            <TextView
                android:textSize="14.0sp"
                android:textColor="#ffffffff"
                android:layout_gravity="end|center"
                android:id="@+id/inv_record_time_collapsed"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:fontFamily="@android:string/config_controlsPackage"
                android:layout_marginEnd="12.0dip" />
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/inv_expanded_content"
            android:paddingTop="12.0dip"
            android:paddingBottom="12.0dip"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:paddingStart="16.0dip"
            android:paddingEnd="16.0dip">
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:id="@+id/inv_media_top_row"
                android:layout_width="fill_parent"
                android:layout_height="78.0dip">
                <Space
                    android:layout_width="72.0dip"
                    android:layout_height="1.0dip" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/inv_media_text_box"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:layout_weight="1.0"
                    android:layout_marginStart="12.0dip"
                    android:layout_marginEnd="12.0dip">
                    <inv.systemui.dynamic.InvMarqueeTextView
                        android:textSize="17.0sp"
                        android:textColor="#ffffffff"
                        android:ellipsize="marquee"
                        android:id="@+id/inv_media_title"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:fadingEdge="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="Song Title"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:requiresFadingEdge="horizontal"
                        android:fontFamily="@android:string/config_controlsPackage" />
                    <inv.systemui.dynamic.InvMarqueeTextView
                        android:textSize="14.0sp"
                        android:textColor="#ccffffff"
                        android:ellipsize="marquee"
                        android:id="@+id/inv_media_artist"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:fadingEdge="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:text="Artist"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:requiresFadingEdge="horizontal"
                        android:fontFamily="@android:string/config_companionDeviceManagerPackage" />
                </LinearLayout>
                <Space
                    android:layout_width="54.0dip"
                    android:layout_height="1.0dip" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/inv_media_progress_row"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:layout_marginHorizontal="5.0dip">
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="#e6ffffff"
                    android:id="@+id/inv_media_time_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:fontFamily="@android:string/config_companionDeviceManagerPackage" />
                <SeekBar
                    android:id="@+id/inv_media_seekbar"
                    android:background="@null"
                    android:layout_width="0.0dip"
                    android:layout_height="8.0dip"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/inv_seekbar_progress"
                    android:thumb="@drawable/inv_seekbar_thumb_invisible"
                    android:layout_weight="1.0"
                    android:paddingStart="0.0dip"
                    android:paddingEnd="0.0dip"
                    android:layout_marginStart="12.0dip"
                    android:layout_marginEnd="12.0dip"
                    android:splitTrack="false" />
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="#e6ffffff"
                    android:id="@+id/inv_media_time_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-0:00"
                    android:fontFamily="@android:string/config_companionDeviceManagerPackage" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/inv_media_controls"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip">
                <ImageView
                    android:id="@+id/inv_media_prev"
                    android:padding="11.0dip"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="42.0dip"
                    android:layout_height="42.0dip"
                    android:src="@drawable/inv_ic_prev"
                    android:scaleType="centerInside"
                    android:tint="#ffffffff" />
                <ImageView
                    android:id="@+id/inv_media_play_pause"
                    android:padding="13.0dip"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="58.0dip"
                    android:layout_height="58.0dip"
                    android:src="@drawable/inv_ic_pause"
                    android:scaleType="centerInside"
                    android:tint="#ffffffff"
                    android:layout_marginStart="20.0dip"
                    android:layout_marginEnd="20.0dip" />
                <ImageView
                    android:id="@+id/inv_media_next"
                    android:padding="11.0dip"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="42.0dip"
                    android:layout_height="42.0dip"
                    android:src="@drawable/inv_ic_next"
                    android:scaleType="centerInside"
                    android:tint="#ffffffff" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/inv_power_notice_content"
            android:paddingTop="0.0dip"
            android:paddingBottom="0.0dip"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:paddingStart="14.0dip"
            android:paddingEnd="14.0dip">
            <TextView
                android:textSize="14.0sp"
                android:textColor="#ffffffff"
                android:ellipsize="end"
                android:id="@+id/inv_charging_title"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="Charging"
                android:singleLine="true"
                android:layout_weight="1.0"
                android:fontFamily="@android:string/config_controlsPackage" />
            <TextView
                android:textSize="13.0sp"
                android:textColor="#ff30d158"
                android:id="@+id/inv_charging_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:fontFamily="@android:string/config_controlsPackage"
                android:layout_marginStart="8.0dip" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/inv_record_expanded_content"
            android:paddingTop="16.0dip"
            android:paddingBottom="16.0dip"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:paddingStart="16.0dip"
            android:paddingEnd="16.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/inv_record_info_box"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/inv_record_timer_row"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14.0sp"
                        android:textColor="#ffff3b30"
                        android:id="@+id/inv_record_dot_expanded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●" />
                    <TextView
                        android:textSize="14.0sp"
                        android:textColor="#ffff453a"
                        android:id="@+id/inv_record_time_expanded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:fontFamily="@android:string/config_controlsPackage"
                        android:layout_marginStart="5.0dip" />
                </LinearLayout>
                <TextView
                    android:textSize="17.0sp"
                    android:textColor="#ffffffff"
                    android:ellipsize="end"
                    android:id="@+id/inv_record_title"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="Screen Recording"
                    android:singleLine="true"
                    android:fontFamily="@android:string/config_controlsPackage" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/inv_record_stop"
                android:background="@drawable/inv_record_stop_ring"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="45.0dip"
                android:layout_height="45.0dip"
                android:layout_marginStart="12.0dip">
                <View
                    android:layout_gravity="center"
                    android:id="@+id/inv_record_stop_square"
                    android:background="@drawable/inv_record_stop_square"
                    android:layout_width="18.0dip"
                    android:layout_height="18.0dip" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>