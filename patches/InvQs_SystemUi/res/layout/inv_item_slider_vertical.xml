<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:stateListAnimator="@null"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:id="@+id/slider_body"
        android:background="@drawable/inv_bg_slider_track"
        android:saveEnabled="false"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:stateListAnimator="@null"
        android:clipToOutline="true">
        <View
            android:layout_gravity="bottom"
            android:id="@+id/slider_fill"
            android:background="@drawable/inv_bg_slider_fill_vertical"
            android:saveEnabled="false"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:alpha="1.0"
            android:stateListAnimator="@null" />
        <ImageView
            android:layout_gravity="bottom|center"
            android:id="@+id/slider_icon"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:layout_marginBottom="14.0dip"
            android:tint="@color/inv_icon_primary" />
    </FrameLayout>
    <ImageView
        android:layout_gravity="start|center|top"
        android:id="@+id/badge"
        android:background="@drawable/inv_bg_badge"
        android:padding="4.0dip"
        android:visibility="gone"
        android:layout_width="22.0dip"
        android:layout_height="22.0dip"
        android:src="@drawable/inv_ic_remove"
        android:tint="@color/inv_edit_badge_icon_tint"
        android:contentDescription="Remove"
        android:translationZ="0.0dip"
        android:elevation="0.0dip" />
</FrameLayout>