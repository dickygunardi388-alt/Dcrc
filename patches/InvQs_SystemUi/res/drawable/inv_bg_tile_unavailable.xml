<?xml version="1.0" encoding="utf-8"?>
<ripple
    android:color="@color/inv_transparent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/inv_tile_bg_off" />
            <corners
                android:radius="18.0dip" />
        </shape>
    </item>
    <item
        android:id="@android:id/mask">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/inv_tile_overlay_white" />
            <corners
                android:radius="18.0dip" />
        </shape>
    </item>
</ripple>