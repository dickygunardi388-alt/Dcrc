# Salin file ini jadi config/patch.env lalu sesuaikan dengan ROM target kalian.
# File ini di-source oleh scripts/*.sh, jangan pakai spasi di sekitar '='.

# --- Lokasi APK input (relatif ke root repo) ---
SYSTEMUI_APK=input/SystemUI.apk
SETTINGS_APK=input/Settings.apk

# Opsional: framework-res.apk dari dump ROM yang sama, kalau apktool butuh
# resolve resource id framework pas decode/build. Kosongkan kalau tidak perlu.
FRAMEWORK_RES_APK=

# --- Versi apktool yang dipakai (rilis GitHub iBotPeaches/Apktool) ---
APKTOOL_VERSION=2.9.3

# --- Keystore untuk signing hasil build ---
# Kalau KEYSTORE_BASE64 dikosongkan, workflow otomatis generate debug keystore
# (hanya untuk testing di device kalian sendiri yang sudah unsigned/bisa sideload
# system app, atau untuk cek hasil decompile-recompile-nya jalan tanpa error).
KEYSTORE_BASE64=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=

# --- Settings.apk patch: sesuaikan dengan kelas preference custom ROM kalian ---
# Nilai default di bawah ini SUDAH dicek langsung dari res/xml/ hasil decompile
# Settings.apk LineageOS 20 (Android 13) — bukan tebakan dari guide.txt rvOS.
#
# - Switch: LineageOS punya class sendiri yang auto-persist ke Settings.System,
#   namanya LineageSystemSettingSwitchPreference (ada prefix "Lineage", beda
#   dengan nama contoh "SystemSettingSwitchPreference" di guide.txt asli).
# - Seekbar: LineageOS 20 TIDAK punya varian "SystemSettingSeekBarPreference"
#   yang auto-persist. Yang ada cuma SeekBarPreference generik (baca/simpan
#   nilainya harus di-handle manual oleh fragment InvQsCustomControls yang
#   sudah dibundel di smali.zip). Kalau nanti slider tidak menyimpan nilai
#   setelah dipasang, cek logic di smali fragment itu, bukan ganti nama class.
SETTINGS_SWITCH_PREF_CLASS=lineageos.preference.LineageSystemSettingSwitchPreference
SETTINGS_SEEKBAR_PREF_CLASS=com.android.settings.widget.SeekBarPreference

# xml tempat entry "Custom Controls" mau ditaruh, relatif terhadap
# <decompiled Settings>/res/xml/  (contoh: top_level_settings.xml, display_settings.xml, dst)
SETTINGS_TARGET_XML=top_level_settings.xml
